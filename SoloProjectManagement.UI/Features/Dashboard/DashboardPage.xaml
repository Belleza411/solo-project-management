<Page x:Class="SoloProjectManagement.UI.Features.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SoloProjectManagement.UI.Features.Dashboard"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dashboard">

    <ScrollViewer Margin="40, 34">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <ui:TextBlock 
                        Text="{Binding DateText}"
                        FontSize="10"/>
                    <ui:TextBlock 
                        Text="Here's your progress"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,8"/>
                    <ui:TextBlock
                        Text="{Binding Greeting, StringFormat={}{0}. Here how your projects and tasks are shaping up today.}"
                        FontSize="12"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,30,0,30">
                <ui:Card Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.TotalProjects.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="Folder20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.TotalProjects.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.TotalProjects.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.TotalTasks.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="TasksApp20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.TotalTasks.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.TotalTasks.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.CompletedTasksThisWeek.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="TasksApp20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.CompletedTasksThisWeek.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.CompletedTasksThisWeek.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.OverdueTasks.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="TasksApp20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.OverdueTasks.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.OverdueTasks.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock 
                        Grid.Column="0"
                        Text="Recent Projects"
                        FontSize="16"
                        FontWeight="SemiBold"/>

                    <ui:Button Grid.Column="1" 
                       BorderThickness="0"
                       Foreground="Blue" 
                       Cursor="Hand"           
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center">
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <ui:TextBlock Text="View All Projects"  Margin="0,0,6,0" FontSize="11"/>
                            <ui:SymbolIcon Symbol="ArrowUpRight16" FontSize="10" />
                        </DockPanel>
                    </ui:Button>
                </Grid>


                <ItemsControl ItemsSource="{Binding RecentProjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card>
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontSize="11" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Opacity="0.6" Margin="0,4,0,12" />
                                    <Grid>
                                        <TextBlock Text="{Binding TasksText}" FontSize="11" />
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Maximum="100" Height="6" Margin="0,4,0,8" />
                                    <TextBlock Text="{Binding DueDate, StringFormat={}{0:MMM dd}}"
                                           HorizontalAlignment="Right" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
