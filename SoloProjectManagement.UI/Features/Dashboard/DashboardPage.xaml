<Page x:Class="SoloProjectManagement.UI.Features.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SoloProjectManagement.UI.Features.Dashboard"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dashboard">

    <ScrollViewer 
        Margin="40,34"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        CanContentScroll="False"
        PanningMode="VerticalOnly">
        <StackPanel>
            <StackPanel>
                <ui:TextBlock 
                        Text="{Binding DateText}"
                        FontSize="10"/>
                <ui:TextBlock 
                        Text="Here's your progress"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,8"/>
                <ui:TextBlock
                        Text="{Binding Greeting, StringFormat={}{0}. Here how your projects and tasks are shaping up today.}"
                        FontSize="12"/>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,30,0,30">
                <ui:Card Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.TotalProjects.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="Folder20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.TotalProjects.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.TotalProjects.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.TotalTasks.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="TasksApp20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.TotalTasks.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.TotalTasks.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.CompletedTasksThisWeek.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="TasksApp20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.CompletedTasksThisWeek.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.CompletedTasksThisWeek.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="{Binding Overview.OverdueTasks.Title}" FontSize="14" Grid.Column="0"/>

                            <ui:SymbolIcon Grid.Column="1" Symbol="TasksApp20" FontSize="20"/>
                        </Grid>
                        <ui:TextBlock Text="{Binding Overview.OverdueTasks.Value}" FontSize="32" Margin="0,10" />
                        <ui:TextBlock Text="{Binding Overview.OverdueTasks.SubValue}" FontSize="12"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock 
                        Grid.Column="0"
                        Text="Recent Projects"
                        FontSize="16"
                        FontWeight="SemiBold"/>

                    <ui:Button 
                        Grid.Column="1" 
                        BorderThickness="0"
                        Foreground="Blue" 
                        Cursor="Hand"           
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Command="{Binding ViewAllProjectsCommand}">
                        <DockPanel 
                            LastChildFill="True" 
                            VerticalAlignment="Center">
                            <ui:TextBlock 
                                Text="View All Projects"  
                                Margin="0,0,6,0" 
                                FontSize="11"/>
                            <ui:SymbolIcon Symbol="ArrowUpRight16" FontSize="10" />
                        </DockPanel>
                    </ui:Button>
                </Grid>


                <ItemsControl ItemsSource="{Binding RecentProjects}" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,16,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Grid.Column="0" Style="{StaticResource ProjectIconTile}"
                                            Content="{Binding}"/>

                                        <ContentControl Grid.Column="1" Style="{StaticResource ProjectStatusBadge}"
                                            Content="{Binding Status, Converter={StaticResource SpacedEnumConverter}}"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,24">
                                        <ui:TextBlock Text="{Binding Title}" 
                                            FontSize="18" 
                                            FontWeight="SemiBold" 
                                            Foreground="#1A1A1A" 
                                            Margin="0,0,0,6"
                                            TextWrapping="Wrap"/>

                                        <ui:TextBlock Text="{Binding Description}" 
                                            FontSize="14" 
                                            Foreground="#666666" 
                                            TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Margin="0,0,0,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ui:TextBlock Grid.Row="0" Text="{Binding TasksFraction}" FontSize="13" Foreground="#666666" HorizontalAlignment="Left"/>
                                        <ui:TextBlock Grid.Row="0" Text="{Binding ProgressPercent, StringFormat={}{0}%}"  FontSize="13" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Right"/>

                                        <ProgressBar 
                                            Grid.Row="1" 
                                            Value="{Binding ProgressPercent, Mode=OneWay}" 
                                            Minimum="0" 
                                            Maximum="100" 
                                            Height="6" 
                                            Margin="0,8,0,0"
                                            BorderThickness="0"/>
                                    </Grid>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <ui:SymbolIcon Symbol="ArrowRight12" Margin="0,0,6,0"/>
                                        <ui:TextBlock Text="{Binding MarkedTask}" FontSize="12" Foreground="#666666" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:TextBlock Text="📅" FontSize="12" Foreground="#666666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="{Binding DueDateText, StringFormat={}{0:MMM dd}}" FontSize="10" Foreground="#666666" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ui:TextBlock 
                Text="Recent Tasks"
                Margin="0,10"
                FontSize="16"
                FontWeight="SemiBold"/>

            <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="20,12" CornerRadius="8,8,0,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Task name" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Status"    Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Priority"  Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="3" Text="Due date"  Style="{StaticResource HeaderText}"/>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border 
                                    Padding="20,14"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:TextBlock 
                                                Text="{Binding Name}" 
                                                Style="{StaticResource TaskTitle}" />

                                            <ui:TextBlock 
                                                Text="{Binding ProjectTitle}" 
                                                FontSize="12" 
                                                Margin="0,3,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <ContentControl 
                                            Grid.Column="1" 
                                            Style="{StaticResource TaskStatusBadge}"
                                            Content="{Binding Status, Converter={StaticResource SpacedEnumConverter}}"/>

                                        <StackPanel 
                                            Grid.Column="2" 
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                            <ui:SymbolIcon Style="{StaticResource PriorityFlag}"/>
                                            <TextBlock Style="{StaticResource PriorityGlyph}"/>
                                            <TextBlock 
                                                Text="{Binding Priority}" 
                                                FontSize="12.5" 
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock 
                                            Grid.Column="3" 
                                            Text="{Binding DueDateText}" 
                                            Style="{StaticResource DueText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="20,10">
                        <TextBlock Text="Showing 6 of 42 tasks" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                            Content="Add task" Icon="{ui:SymbolIcon Add24}"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Command="{Binding AddTaskCommand}"/>
                    </Grid>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
 