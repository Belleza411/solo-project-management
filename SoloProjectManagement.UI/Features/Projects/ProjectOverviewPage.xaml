<Page x:Class="SoloProjectManagement.UI.Features.Projects.ProjectOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SoloProjectManagement.UI.Features.Projects"
      mc:Ignorable="d" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectOverviewPage">
    
    <ScrollViewer
        Margin="40,34">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" DataContext="{Binding Project}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl 
                        Grid.Column="0" 
                        Style="{StaticResource ProjectIconTile}"
                        Content="{Binding}"/>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Text="{Binding Title}" 
                                FontSize="26" 
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" 
                                VerticalAlignment="Center"/>
                            <ContentControl 
                                Style="{StaticResource ProjectStatusBadge}"
                                Content="{Binding Status, Converter={StaticResource SpacedEnumConverter}}"
                                Margin="12,4,0,0"/>
                        </StackPanel>
                        <TextBlock 
                            Text="{Binding Description}" 
                            FontSize="12" 
                            TextWrapping="Wrap" 
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button 
                        Content="+  Add task"
                        Command="{Binding NewTaskCommand}"
                        Margin="0,0,16,0"/>

                    <ui:DropDownButton
                        BorderThickness="0"
                        BorderBrush="Transparent"
                        Background="Transparent"
                        Appearance="Transparent"
                        Padding="6,2"
                        Icon="{ui:SymbolIcon MoreHorizontal48}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">

                        <ui:DropDownButton.Resources>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <Trigger Property="Symbol" Value="ChevronDown24">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Symbol" Value="MoreHorizontal48">
                                        <Setter Property="FontSize" Value="20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:DropDownButton.Resources>

                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem 
                                    Header="Edit"
                                    Icon="{ui:SymbolIcon Edit24}"
                                    Command="{Binding PlacementTarget.Tag.EditProjectCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding PlacementTarget.Tag.Project,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem 
                                    Header="Delete"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    Command="{Binding PlacementTarget.Tag.DeleteProjectCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding PlacementTarget.Tag.Project,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
            </Grid>

            <ui:Card
                Padding="0"
                Margin="0,20,0,20"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Grid Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" MinWidth="170"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="20,0,24,0"
                        VerticalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <ui:TextBlock 
                                Text="Project progress" 
                                FontWeight="SemiBold" 
                                VerticalAlignment="Bottom"/>
                            <ui:TextBlock 
                                Text="{Binding PercentText}" 
                                FontSize="28"
                                FontWeight="SemiBold" 
                                HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Height="8"
                            Value="{Binding ProgressPercent, Mode=OneWay}"/>
                        <ui:TextBlock
                            Text="{Binding ProgressText}"
                            Margin="0,10,0,0"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Width="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                    <Grid Grid.Column="2" Margin="24,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CompletedCount}" FontSize="28"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Completed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding InProgressCount}" FontSize="28"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            <TextBlock Text="In progress"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding TodoCount}" FontSize="28"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="To do"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="3" Width="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                    <StackPanel Grid.Column="4" Margin="24,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="Due date"/>
                        <TextBlock Text="{Binding DueDateText}"
                                   FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding UpdatedText}"/>
                    </StackPanel>
                </Grid>
             
            </ui:Card>
            <ui:Card Padding="0" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="20,12" CornerRadius="8,8,0,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Task name" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Priority" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="3" Text="Due date" Style="{StaticResource HeaderText}"/>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border 
                                    Padding="20,14"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock 
                                            Grid.Column="0"
                                            Text="{Binding Name}" 
                                            Style="{StaticResource TaskTitle}" />

                                        <ComboBox 
                                            Grid.Column="1"
                                            ItemsSource="{Binding Statuses}"
                                            SelectedItem="{Binding Status}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:TextBlock Text="{Binding Converter={StaticResource SpacedEnumConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <StackPanel 
                                            Grid.Column="2" 
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                            <ui:SymbolIcon Style="{StaticResource PriorityFlag}"/>
                                            <TextBlock Style="{StaticResource PriorityGlyph}"/>
                                            <TextBlock 
                                                Text="{Binding Priority}" 
                                                FontSize="12.5" 
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock 
                                            Grid.Column="3" 
                                            Text="{Binding DueDate, StringFormat={}{0:MMM dd}}" 
                                            Style="{StaticResource DueText}"/>

                                        <ui:DropDownButton
                                            Grid.Column="4"
                                            BorderThickness="0"
                                            BorderBrush="Transparent"
                                            Background="Transparent"
                                            Appearance="Transparent"
                                            Padding="6,2"
                                            Icon="{ui:SymbolIcon MoreHorizontal48}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                            <ui:DropDownButton.Resources>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Style.Triggers>
                                                        <Trigger Property="Symbol" Value="ChevronDown24">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="Symbol" Value="MoreHorizontal48">
                                                            <Setter Property="FontSize" Value="20"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:DropDownButton.Resources>

                                            <ui:DropDownButton.Flyout>
                                                <ContextMenu>
                                                    <MenuItem 
                                                        Header="Edit"
                                                        Icon="{ui:SymbolIcon Edit24}"
                                                        Command="{Binding PlacementTarget.Tag.EditTaskCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        CommandParameter="{Binding PlacementTarget.DataContext,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem 
                                                        Header="Delete"
                                                        Icon="{ui:SymbolIcon Delete24}"
                                                        Command="{Binding PlacementTarget.Tag.DeleteTaskCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        CommandParameter="{Binding PlacementTarget.DataContext,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </ui:DropDownButton.Flyout>
                                        </ui:DropDownButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
