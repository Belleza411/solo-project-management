<Page x:Class="SoloProjectManagement.UI.Features.Projects.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SoloProjectManagement.UI.Features.Projects"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Projects">

    <Page.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="TextBlock.Foreground" Value="#4B49AC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#4B49AC"/>
                                <Setter Property="Foreground" Value="#4B49AC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer 
            Margin="40,34"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            CanContentScroll="False"
            PanningMode="VerticalOnly">
        <StackPanel Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock
                        Grid.Column="0"
                        Text="Projects"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,8"/>

                <ui:Button
                        Grid.Column="1"
                        Content="Add Project"
                        Command="{Binding AddProjectCommand}"/>
            </Grid>
            <ui:TextBlock
                Text="A clear view of what you’re building, what’s next, and how far you’ve come."
                FontSize="12"/>

            <Grid VerticalAlignment="Top" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="All projects" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active" Foreground="#6C757D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Planned" Foreground="#6C757D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Completed" Foreground="#6C757D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Archived" Foreground="#6C757D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Separator Grid.Row="1" Height="1" Background="#E0E0E0" Margin="0,-1,0,0" VerticalAlignment="Top"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Projects}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentControl 
                                        Grid.Column="0" 
                                        Style="{StaticResource ProjectIconTile}"
                                        Content="{Binding}"/>

                                    <ContentControl 
                                        Grid.Column="1" 
                                        Style="{StaticResource ProjectStatusBadge}"
                                        Margin="0,0,4,0 "
                                        Content="{Binding Status, Converter={StaticResource SpacedEnumConverter}}"/>

                                    <ui:DropDownButton
                                        Grid.Column="2"
                                        BorderThickness="0"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        Appearance="Transparent"
                                        Padding="6,2"
                                        Icon="{ui:SymbolIcon MoreHorizontal28}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">

                                        <ui:DropDownButton.Resources>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Style.Triggers>
                                                    <Trigger Property="Symbol" Value="ChevronDown24">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:DropDownButton.Resources>

                                        <ui:DropDownButton.Flyout>
                                            <ContextMenu>
                                                <MenuItem 
                                                    Header="Edit"
                                                    Icon="{ui:SymbolIcon Edit24}"
                                                    Command="{Binding PlacementTarget.Tag.EditProjectCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem 
                                                    Header="Delete"
                                                    Icon="{ui:SymbolIcon Delete24}"
                                                    Command="{Binding PlacementTarget.Tag.DeleteProjectCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </ui:DropDownButton.Flyout>
                                    </ui:DropDownButton>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                                    <ui:TextBlock Text="{Binding Title}" 
                                            FontSize="18" 
                                            FontWeight="SemiBold" 
                                            Foreground="#1A1A1A" 
                                            Margin="0,0,0,6"
                                            TextWrapping="Wrap"/>

                                    <ui:TextBlock Text="{Binding Description}" 
                                            FontSize="14" 
                                            Foreground="#666666" 
                                            TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,0,0,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ui:TextBlock Grid.Row="0" Text="{Binding TasksFraction}" FontSize="13" Foreground="#666666" HorizontalAlignment="Left"/>
                                    <ui:TextBlock Grid.Row="0" Text="{Binding ProgressPercent, StringFormat={}{0}%}"  FontSize="13" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Right"/>

                                    <ProgressBar 
                                        Grid.Row="1" 
                                        Value="{Binding ProgressPercent, Mode=OneWay}" 
                                        Minimum="0" 
                                        Maximum="100" 
                                        Height="6" 
                                        Margin="0,8,0,0"
                                        BorderThickness="0"/>
                                </Grid>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="ArrowRight12" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="{Binding MarkedTask, StringFormat={}{0:MMM dd}}" FontSize="12" Foreground="#666666" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ui:TextBlock Text="📅" FontSize="12" Foreground="#666666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="{Binding DueDateText, StringFormat={}{0:MMM dd}}" FontSize="10" Foreground="#666666" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ui:Button 
                                        Grid.Column="1" 
                                        Icon="{ui:SymbolIcon Symbol=ArrowUpRight24}"
                                        Command="{Binding DataContext.GoToOverviewCommand,
                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                </Grid>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:TextBlock Text="{Binding ProjectsFooter}" FontSize="11"/>
        </StackPanel>
    </ScrollViewer>
</Page>