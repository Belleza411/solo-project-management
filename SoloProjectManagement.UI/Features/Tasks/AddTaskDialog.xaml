<ui:ContentDialog 
    x:Class="SoloProjectManagement.UI.Features.Tasks.AddTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DialogMaxWidth="560"
    IsFooterVisible="False">

    <ui:ContentDialog.Title>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Add Task" FontSize="24" FontWeight="SemiBold"/>

            <ui:Button 
                Grid.Column="1"
                Appearance="Transparent"
                Padding="6"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Icon="{ui:SymbolIcon Dismiss16}"/>
        </Grid>
    </ui:ContentDialog.Title>

    <StackPanel MinWidth="480">
        <ui:TextBlock 
            Text="Name" 
            FontWeight="Medium" 
            Margin="0,0,0,6"/>
        <ui:TextBox 
            PlaceholderText="Name"
            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <ui:TextBlock Text="Description (optional)" FontWeight="Medium" Margin="0,20,0,6"/>
        <ui:TextBox 
            PlaceholderText="Description"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="90"
            VerticalContentAlignment="Top"
            Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <ui:TextBlock Text="Status" FontWeight="Medium" Margin="0,20,0,6"/>
        <ComboBox 
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding Statuses}"
            SelectedItem="{Binding Status}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource SpacedEnumConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ui:TextBlock Text="Priority" FontWeight="Medium" Margin="0,20,0,6"/>
        <ComboBox 
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding Priorities}"
            SelectedItem="{Binding Priority}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource SpacedEnumConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ui:TextBlock Text="Due date (optional)" FontWeight="Medium" Margin="0,20,0,6"/>
        <DatePicker SelectedDate="{Binding DueDate}"/>

        <Border Margin="-24,24,-24,0"
            Padding="24,16"
            Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button 
                    Content="Cancel"
                    Appearance="Secondary"
                    MinWidth="90"
                    IsCancel="True"
                    Click="Cancel_Click"/>
                <ui:Button 
                    Content="Create Task"
                    Appearance="Primary"
                    MinWidth="130"
                    Margin="12,0,0,0"
                    IsDefault="True"
                    Click="Create_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:ContentDialog>