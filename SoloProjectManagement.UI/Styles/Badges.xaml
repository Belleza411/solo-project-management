<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate
        x:Key="IconTileTemplate" 
        TargetType="ContentControl">
        <Border Width="40" Height="40"
                CornerRadius="10"
                Background="{TemplateBinding Background}">
            <TextBlock Text="{TemplateBinding Tag}"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="ProjectIconTile" TargetType="ContentControl">
        <Setter Property="Template" Value="{StaticResource IconTileTemplate}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="Tag" Value="&#xE8B7;"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Category}" Value="Web">
                <Setter Property="Background" Value="#DBEAFE"/>
                <Setter Property="Foreground" Value="#1E40AF"/>
                <Setter Property="Tag" Value="&#xE774;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Mobile">
                <Setter Property="Background" Value="#DCFCE7"/>
                <Setter Property="Foreground" Value="#166534"/>
                <Setter Property="Tag" Value="&#xE8EA;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Desktop">
                <Setter Property="Background" Value="#EDE9FE"/>
                <Setter Property="Foreground" Value="#5B21B6"/>
                <Setter Property="Tag" Value="&#xE7F4;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Api">
                <Setter Property="Background" Value="#FEF3C7"/>
                <Setter Property="Foreground" Value="#92400E"/>
                <Setter Property="Tag" Value="&#xE943;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Game">
                <Setter Property="Background" Value="#FCE7F3"/>
                <Setter Property="Foreground" Value="#9D174D"/>
                <Setter Property="Tag" Value="&#xE7FC;"/>

            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ProjectStatusPillTemplate" TargetType="ContentControl">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="ProjectStatusBadge" TargetType="ContentControl">
        <Setter Property="Template" Value="{StaticResource ProjectStatusPillTemplate}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Not Started">
                <Setter Property="Background" Value="#FEF3C7"/>
                <Setter Property="Foreground" Value="#92400E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Archived">
                <Setter Property="Background" Value="#FEE2E2"/>
                <Setter Property="Foreground" Value="#991B1B"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Active">
                <Setter Property="Background" Value="#E5E7EB"/>
                <Setter Property="Foreground" Value="#374151"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Completed">
                <Setter Property="Background" Value="#DBEAFE"/>
                <Setter Property="Foreground" Value="#1E40AF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>