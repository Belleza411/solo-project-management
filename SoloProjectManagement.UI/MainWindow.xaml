<ui:FluentWindow x:Class="SoloProjectManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoloProjectManagement.UI"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:dashboard="clr-namespace:SoloProjectManagement.UI.Features.Dashboard"
        xmlns:projects="clr-namespace:SoloProjectManagement.UI.Features.Projects"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding ApplicationTitle}" />

        <ui:NavigationView 
                x:Name="RootNavigation" 
                Grid.Row="1" 
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type dashboard:DashboardPage}" />
                <ui:NavigationViewItem Content="Projects"
                                       Icon="{ui:SymbolIcon Folder24}"
                                       TargetPageType="{x:Type projects:ProjectsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
