<Application x:Class="SoloProjectManagement.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SoloProjectManagement.UI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SoloProjectManagement.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Styles/Badges.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:SpacedEnumConverter x:Key="SpacedEnumConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
